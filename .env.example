# HireVault — copy to .env at the repository root (not apps/web).
# All apps and tooling read from this single file.

# Supabase (required for web + extension capture API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers (optional — features degrade gracefully without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cursor SDK orchestrator (optional — headless Builder/Tester loop)
CURSOR_API_KEY=

# Supabase CLI (optional — migration automation)
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# PDF export (optional — local Chromium path)
PUPPETEER_EXECUTABLE_PATH=
CHROME_PATH=
